diff --git a/docs/PROTOCOL.md b/docs/PROTOCOL.md
index 924ddfa..d15d732 100644
--- a/docs/PROTOCOL.md
+++ b/docs/PROTOCOL.md
@@ -193,6 +193,10 @@ not touch it); `ESC c` resets everything to the classic single-plane look.
 CSI = Ps z            select the active text layer (Ps = 0..15, clamped)
 CSI = Ps ; Pd * z     set layer Ps depth: Pd centi-world-units BEHIND the
                       glass (0 = at the glass; 150 = 1.5 units; clamp 0..1800)
+CSI = Ps ; Pd + z     set layer Ps depth: Pd centi-world-units IN FRONT of the
+                      glass (pop-out; clamp 0..180). Protocol 0.4. A 0.3 client
+                      reads this as a layer select, so send `CSI = 0 z` after
+                      your definitions and such text simply sits at the glass.
 ```
 
 - Writes, erases and fills stamp the active layer; scroll/insert/delete ops
diff --git a/source/gfx/scene3d.c b/source/gfx/scene3d.c
index 4a2ee32..c8e0c82 100644
--- a/source/gfx/scene3d.c
+++ b/source/gfx/scene3d.c
@@ -305,8 +305,8 @@ void scene3dTextShifts(float iod, const float* depths, int n, float* outPx)
 	LightLock_Unlock(&sLock);
 	float halfTan = tanf(C3D_AngleFromDegrees(fov) * 0.5f);
 	for (int i = 0; i < n; i++) {
-		float d = depths[i] < 0.0f ? 0.0f : depths[i];
-		float D = 2.0f + d;
+		float D = 2.0f + depths[i];      // negative depth = in front of the glass: crossed disparity
+		if (D < 0.2f) D = 0.2f;
 		float ndc = 0.5f * iod * (1.0f / 2.0f - 1.0f / D)
 		            / (halfTan * C3D_AspectRatioTop);
 		outPx[i] = ndc * (400.0f * 0.5f);
diff --git a/source/term/ansi.c b/source/term/ansi.c
index 1cfe80f..e1720f6 100644
--- a/source/term/ansi.c
+++ b/source/term/ansi.c
@@ -328,10 +328,15 @@ static void csiDispatch(AnsiParser* p, u8 final)
 			//   CSI = Ps z       select active layer (0..15)
 			//   CSI = Ps ; Pd * z  set layer Ps depth to Pd centi-world-
 			//                      units behind the glass (0 = glass)
+			//   CSI = Ps ; Pd + z  set layer Ps depth to Pd centi-world-
+			//                      units IN FRONT of the glass (pop-out)
 			if (p->priv == '=') {
 				if (p->intermediate == '*')
 					termSetLayerDepth(t, param(p, 0, 0),
 					                  param(p, 1, 0) / 100.0f);
+				else if (p->intermediate == '+')
+					termSetLayerDepth(t, param(p, 0, 0),
+					                  -param(p, 1, 0) / 100.0f);
 				else
 					termSelectLayer(t, param(p, 0, 0));
 			}
diff --git a/source/term/termbuf.c b/source/term/termbuf.c
index c28ed9c..26d6045 100644
--- a/source/term/termbuf.c
+++ b/source/term/termbuf.c
@@ -103,7 +103,8 @@ void termSetLayerDepth(Terminal* t, int layer, float depth)
 {
 	if (layer < 0 || layer >= TERM_TEXT_LAYERS)
 		return;
-	if (depth < 0.0f) depth = 0.0f;
+	// negative = in front of the glass; -1.8 leaves the plane 0.2 from the camera
+	if (depth < -1.8f) depth = -1.8f;
 	if (depth > 18.0f) depth = 18.0f;
 	t->layerDepth[layer] = depth;
 	t->rev++;
